// PRACTICAL NO. 2: Infix to Postfix Expression Conversion
// ============================================================
int precedenceP2(char op) {
    if (op == '^') return 3;
    if (op == '*' || op == '/') return 2;
    if (op == '+' || op == '-') return 1;
    return 0;
}

bool isOperandP2(char c) {
    return isalnum(static_cast<unsigned char>(c));
}

string infixToPostfixP2(string expr) {
    stack<char> st;
    string result = "";

    for (char c : expr) {
        if (isOperandP2(c)) {
            result += c;
        }
        else if (c == '(') {
            st.push(c);
        }
        else if (c == ')') {
            while (!st.empty() && st.top() != '(') {
                result += st.top();
                st.pop();
            }
            if (!st.empty())
                st.pop();
        }
        else {
            while (!st.empty() &&
                   precedenceP2(st.top()) >= precedenceP2(c)) {
                result += st.top();
                st.pop();
            }
            st.push(c);
        }
    }

    while (!st.empty()) {
        result += st.top();
        st.pop();
    }

    return result;
}

void practical2() {
    string expr;

    cout << "Enter infix expression: ";
    cin >> expr;

    cout << "Postfix: " << infixToPostfixP2(expr) << endl;
}


// ============================================================
// PRACTICAL NO. 3: Postfix Expression Evaluation using Stack
// ============================================================
int evaluatePostfixP3(string expr) {
    stack<int> st;

    for (char c : expr) {
        if (isdigit(static_cast<unsigned char>(c))) {
            st.push(c - '0');
        }
        else {
            int b = st.top();
            st.pop();

            int a = st.top();
            st.pop();

            switch (c) {
                case '+':
                    st.push(a + b);
                    break;
                case '-':
                    st.push(a - b);
                    break;
                case '*':
                    st.push(a * b);
                    break;
                case '/':
                    st.push(a / b);
                    break;
                case '^': {
                    int res = 1;
                    for (int i = 0; i < b; i++)
                        res *= a;
                    st.push(res);
                    break;
                }
            }
        }
    }

    return st.top();
}

void practical3() {
    string expr;

    cout << "Enter postfix expression: ";
    cin >> expr;

    cout << "Result: " << evaluatePostfixP3(expr) << endl;
}


