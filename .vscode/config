void hanoiP4(int n, char src, char dest, char aux) {
    if (n == 1) {
        cout << "Move disk 1 from " << src << " to " << dest << "\n";
        return;
    }

    hanoiP4(n - 1, src, aux, dest);
    cout << "Move disk " << n << " from " << src << " to " << dest << "\n";
    hanoiP4(n - 1, aux, dest, src);
}

