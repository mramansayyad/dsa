// PRACTICAL NO. 8: Circular Linked List
// ============================================================
struct NodeP8 {
    int data;
    NodeP8* next;

    NodeP8(int d) : data(d), next(nullptr) {}
};

class CLLP8 {
    NodeP8* tail;

public:
    CLLP8() : tail(nullptr) {}

    void insertAtBegin(int val) {
        NodeP8* n = new NodeP8(val);

        if (!tail) {
            tail = n;
            n->next = n;
        }
        else {
            n->next = tail->next;
            tail->next = n;
        }

        cout << val << " inserted at beginning.\n";
    }

    void insertAtEnd(int val) {
        NodeP8* n = new NodeP8(val);

        if (!tail) {
            tail = n;
            n->next = n;
        }
        else {
            n->next = tail->next;
            tail->next = n;
            tail = n;
        }

        cout << val << " inserted at end.\n";
    }

    void deleteNode(int val) {
        if (!tail) {
            cout << "List empty.\n";
            return;
        }

        NodeP8* curr = tail->next;
        NodeP8* prev = tail;

        do {
            if (curr->data == val) {
                if (curr == tail && curr == tail->next) {
                    tail = nullptr;
                }
                else {
                    prev->next = curr->next;

                    if (curr == tail)
                        tail = prev;
                }

                delete curr;
                cout << val << " deleted.\n";
                return;
            }

            prev = curr;
            curr = curr->next;

        } while (curr != tail->next);

        cout << val << " not found.\n";
    }

    void traverse() {
        if (!tail) {
            cout << "List empty.\n";
            return;
        }

        NodeP8* curr = tail->next;

        cout << "CLL: ";

        do {
            cout << curr->data << " -> ";
            curr = curr->next;
        } while (curr != tail->next);

        cout << "(back to head)\n";
    }

    void search(int val) {
        if (!tail) {
            cout << "List empty.\n";
            return;
        }

        NodeP8* curr = tail->next;
        int pos = 1;

        do {
            if (curr->data == val) {
                cout << val << " found at position "
                     << pos << "\n";
                return;
            }

            curr = curr->next;
            pos++;

        } while (curr != tail->next);

        cout << val << " not found.\n";
    }
};

void practical8() {
    CLLP8 list;
    int ch, val;

    do {
        cout << "\n1.InsertBegin 2.InsertEnd 3.Delete "
             << "4.Traverse 5.Search 0.Exit\n";
        cout << "Choice: ";
        cin >> ch;

        switch (ch) {
            case 1:
