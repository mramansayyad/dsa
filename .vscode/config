// PRACTICAL NO. 9: Linear Search, Binary Search,
//                 Interpolation Search
// ============================================================
int linearSearchP9(const vector<int>& arr, int key) {
    for (int i = 0; i < static_cast<int>(arr.size()); i++) {
        if (arr[i] == key)
            return i;
    }

    return -1;
}

int binarySearchP9(const vector<int>& arr, int key) {
    int low = 0;
    int high = static_cast<int>(arr.size()) - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] == key)
            return mid;
        else if (arr[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

int interpolationSearchP9(const vector<int>& arr, int key) {
    int low = 0;
    int high = static_cast<int>(arr.size()) - 1;

    while (low <= high &&
           key >= arr[low] &&
           key <= arr[high]) {

        if (low == high) {
            if (arr[low] == key)
                return low;
            return -1;
        }

        if (arr[high] == arr[low])
            return (arr[low] == key) ? low : -1;

        int pos = low +
                  static_cast<int>(
                      (static_cast<double>(high - low) /
                       (arr[high] - arr[low])) *
                      (key - arr[low])
                  );

        if (arr[pos] == key)
            return pos;

        if (arr[pos] < key)
            low = pos + 1;
        else
            high = pos - 1;
    }

    return -1;
}

void printResultP9(string name, int idx, int key) {
    if (idx != -1)
        cout << name << ": " << key
             << " found at index " << idx << "\n";
    else
        cout << name << ": " << key
             << " not found.\n";
}

void practical9() {
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    vector<int> arr(n);

    cout << "Enter " << n << " elements: ";
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    sort(arr.begin(), arr.end());

    cout << "Sorted array: ";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";
    cout << "\n";

    int key;

    cout << "Enter key to search: ";
    cin >> key;

    printResultP9(
        "Linear Search",
        linearSearchP9(arr, key),
        key
    );

    printResultP9(
        "Binary Search",
        binarySearchP9(arr, key),
        key
    );

    printResultP9(
        "Interpolation Search",
        interpolationSearchP9(arr, key),
        key
    );
}


// ============================================================
// PRACTICAL NO. 10: Bubble Sort, Selection Sort,
//                  Insertion Sort, Quick Sort, Merge Sort
// ============================================================
void printArrP10(const vector<int>& a) {
    for (int x : a)
        cout << x << " ";
    cout << "\n";
}

void bubbleSortP10(vector<int>& a) {
    int n = static_cast<int>(a.size());

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {
            if (a[j] > a[j + 1])
                swap(a[j], a[j + 1]);
        }
    }
}

void selectionSortP10(vector<int>& a) {
    int n = static_cast<int>(a.size());

    for (int i = 0; i < n - 1; i++) {
        int minIdx = i;

        for (int j = i + 1; j < n; j++) {
            if (a[j] < a[minIdx])
                minIdx = j;
        }

        swap(a[i], a[minIdx]);
    }
}

void insertionSortP10(vector<int>& a) {
    int n = static_cast<int>(a.size());

    for (int i = 1; i < n; i++) {
        int key = a[i];
        int j = i - 1;

        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j--;
        }

        a[j + 1] = key;
    }
}

int partitionP10(vector<int>& a, int low, int high) {
    int pivot = a[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (a[j] <= pivot)
            swap(a[++i], a[j]);
    }

    swap(a[i + 1], a[high]);

    return i + 1;
}

void quickSortP10(vector<int>& a, int low, int high) {
    if (low < high) {
        int pi = partitionP10(a, low, high);

        quickSortP10(a, low, pi - 1);
        quickSortP10(a, pi + 1, high);
    }
}

void mergeP10(vector<int>& a, int l, int m, int r) {
    vector<int> L(
        a.begin() + l,
        a.begin() + m + 1
    );

    vector<int> R(
        a.begin() + m + 1,
        a.begin() + r + 1
    );

    int i = 0;
    int j = 0;
    int k = l;

    while (i < static_cast<int>(L.size()) &&
           j < static_cast<int>(R.size())) {

        if (L[i] <= R[j])
            a[k++] = L[i++];
        else
            a[k++] = R[j++];
    }

    while (i < static_cast<int>(L.size()))
        a[k++] = L[i++];

    while (j < static_cast<int>(R.size()))
        a[k++] = R[j++];
}

void mergeSortP10(vector<int>& a, int l, int r) {
    if (l < r) {
        int m = l + (r - l) / 2;

        mergeSortP10(a, l, m);
        mergeSortP10(a, m + 1, r);

        mergeP10(a, l, m, r);
    }
}

void practical10() {
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    vector<int> orig(n);

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> orig[i];

    vector<int> a;

    a = orig;
    bubbleSortP10(a);
    cout << "Bubble Sort: ";
    printArrP10(a);

    a = orig;
    selectionSortP10(a);
    cout << "Selection Sort: ";
    printArrP10(a);

    a = orig;
    insertionSortP10(a);
    cout << "Insertion Sort: ";
    printArrP10(a);

    a = orig;
    quickSortP10(a, 0, n - 1);
    cout << "Quick Sort: ";
    printArrP10(a);

    a = orig;
    mergeSortP10(a, 0, n - 1);
    cout << "Merge Sort: ";
    printArrP10(a);
}


