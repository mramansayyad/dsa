// PRACTICAL NO. 13: Graph Representation - Adjacency List,
//                   Adjacency Matrix, BFS and DFS
// ============================================================
class GraphP13 {
    int V;
    vector<vector<int>> adjList;
    vector<vector<int>> adjMatrix;

public:
    GraphP13(int v) : V(v) {
        adjList.resize(V);
        adjMatrix.assign(V, vector<int>(V, 0));
    }

    void addEdge(int u, int v) {
        adjList[u].push_back(v);
        adjList[v].push_back(u);

        adjMatrix[u][v] = 1;
        adjMatrix[v][u] = 1;
    }

    void printAdjList() {
        cout << "\nAdjacency List:\n";

        for (int i = 0; i < V; i++) {
            cout << i << " -> ";

            for (int x : adjList[i])
                cout << x << " ";

            cout << "\n";
        }
    }

    void printAdjMatrix() {
        cout << "\nAdjacency Matrix:\n ";

        for (int i = 0; i < V; i++)
            cout << i << " ";

        cout << "\n";

        for (int i = 0; i < V; i++) {
            cout << i << " ";

            for (int j = 0; j < V; j++)
                cout << adjMatrix[i][j] << " ";

            cout << "\n";
        }
    }

    void BFS(int start) {
        vector<bool> visited(V, false);
        queue<int> q;

        visited[start] = true;
        q.push(start);

        cout << "\nBFS from " << start << ": ";

        while (!q.empty()) {
            int node = q.front();
            q.pop();

            cout << node << " ";

            for (int nbr : adjList[node]) {
                if (!visited[nbr]) {
                    visited[nbr] = true;
                    q.push(nbr);
                }
            }
        }

        cout << "\n";
    }

    void DFSHelper(int node, vector<bool>& visited) {
        visited[node] = true;
        cout << node << " ";

        for (int nbr : adjList[node]) {
            if (!visited[nbr])
                DFSHelper(nbr, visited);
        }
    }

    void DFS(int start) {
        vector<bool> visited(V, false);

        cout << "DFS from " << start << ": ";
        DFSHelper(start, visited);
        cout << "\n";
    }
};

void practical13() {
    int V, E;

    cout << "Enter number of vertices: ";
    cin >> V;

    cout << "Enter number of edges: ";
    cin >> E;

    GraphP13 g(V);

    cout << "Enter " << E << " edges (u v):\n";

    for (int i = 0; i < E; i++) {
        int u, v;
        cin >> u >> v;
        g.addEdge(u, v);
    }

    g.printAdjList();
    g.printAdjMatrix();

    int start;

    cout << "\nEnter start vertex for traversal: ";
    cin >> start;

    g.BFS(start);
    g.DFS(start);
}


