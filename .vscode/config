// PRACTICAL NO. 7: Doubly Linked List
// ============================================================
struct NodeP7 {
    int data;
    NodeP7* prev;
    NodeP7* next;

    NodeP7(int d) : data(d), prev(nullptr), next(nullptr) {}
};

class DLLP7 {
    NodeP7* head;

public:
    DLLP7() : head(nullptr) {}

    void insertAtBegin(int val) {
        NodeP7* n = new NodeP7(val);

        if (head) {
            n->next = head;
            head->prev = n;
        }

        head = n;
    }

    void insertAtEnd(int val) {
        NodeP7* n = new NodeP7(val);

        if (!head) {
            head = n;
            return;
        }

        NodeP7* temp = head;

        while (temp->next)
            temp = temp->next;

        temp->next = n;
        n->prev = temp;
    }

    void deleteNode(int val) {
        NodeP7* temp = head;

        while (temp && temp->data != val)
            temp = temp->next;

        if (!temp) {
            cout << val << " not found.\n";
            return;
        }

        if (temp->prev)
            temp->prev->next = temp->next;
        else
            head = temp->next;

        if (temp->next)
            temp->next->prev = temp->prev;

        delete temp;

        cout << val << " deleted.\n";
    }

    void traverse() {
        NodeP7* temp = head;

        cout << "Forward: NULL <-> ";

        while (temp) {
            cout << temp->data << " <-> ";
            temp = temp->next;
        }

        cout << "NULL\n";
    }

    void search(int val) {
        NodeP7* temp = head;
        int pos = 1;

        while (temp) {
            if (temp->data == val) {
                cout << val << " at position " << pos << "\n";
                return;
            }

            temp = temp->next;
            pos++;
        }

        cout << val << " not found.\n";
    }

    void reverse() {
        NodeP7* curr = head;
        NodeP7* temp = nullptr;

        while (curr) {
            temp = curr->prev;
            curr->prev = curr->next;
            curr->next = temp;
            curr = curr->prev;
        }

        if (temp)
            head = temp->prev;

        cout << "List reversed.\n";
    }
};

void practical7() {
    DLLP7 list;
    int ch, val;

    do {
        cout << "\n1.InsertBegin 2.InsertEnd 3.Delete "
             << "4.Traverse 5.Search 6.Reverse 0.Exit\n";
        cout << "Choice: ";
        cin >> ch;

        switch (ch) {
            case 1:
                cout << "Val: ";
                cin >> val;
                list.insertAtBegin(val);
                break;
            case 2:
                cout << "Val: ";
                cin >> val;
                list.insertAtEnd(val);
                break;
            case 3:
                cout << "Val: ";
                cin >> val;
                list.deleteNode(val);
                break;
            case 4:
                list.traverse();
                break;
            case 5:
                cout << "Search: ";
                cin >> val;
                list.search(val);
                break;
            case 6:
                list.reverse();
                break;
        }
    } while (ch != 0);
}


