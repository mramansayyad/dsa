NodeP11* insertP11(NodeP11* root, int val) {
    if (!root)
        return new NodeP11(val);

    if (val < root->data)
        root->left = insertP11(root->left, val);
    else if (val > root->data)
        root->right = insertP11(root->right, val);

    return root;
}

NodeP11* minNodeP11(NodeP11* root) {
    while (root->left)
        root = root->left;

    return root;
}

NodeP11* deleteNodeP11(NodeP11* root, int val) {
    if (!root)
        return root;

    if (val < root->data) {
        root->left = deleteNodeP11(root->left, val);
    }
    else if (val > root->data) {
        root->right = deleteNodeP11(root->right, val);
    }
    else {
        if (!root->left) {
            NodeP11* t = root->right;
            delete root;
            return t;
        }

        if (!root->right) {
            NodeP11* t = root->left;
            delete root;
            return t;
        }

        NodeP11* succ = minNodeP11(root->right);
        root->data = succ->data;
        root->right =
            deleteNodeP11(root->right, succ->data);
    }

    return root;
}

void inorderP11(NodeP11* root) {
    if (!root)
        return;

    inorderP11(root->left);
    cout << root->data << " ";
    inorderP11(root->right);
}

void practical11() {
