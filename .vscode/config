// ============================================================
struct NodeP6 {
    int data;
    NodeP6* next;

    NodeP6(int d) : data(d), next(nullptr) {}
};

class SLLP6 {
    NodeP6* head;

public:
    SLLP6() : head(nullptr) {}

    void insertAtBegin(int val) {
        NodeP6* n = new NodeP6(val);
        n->next = head;
        head = n;

        cout << val << " inserted at beginning.\n";
    }

    void insertAtEnd(int val) {
        NodeP6* n = new NodeP6(val);

        if (!head) {
            head = n;
        }
        else {
            NodeP6* temp = head;
            while (temp->next)
                temp = temp->next;

            temp->next = n;
        }

        cout << val << " inserted at end.\n";
    }

    void deleteNode(int val) {
        if (!head) {
            cout << "List empty.\n";
            return;
        }

        if (head->data == val) {
            NodeP6* temp = head;
            head = head->next;
            delete temp;

            cout << val << " deleted.\n";
            return;
        }

        NodeP6* prev = head;
        NodeP6* curr = head->next;

        while (curr && curr->data != val) {
            prev = curr;
            curr = curr->next;
        }

        if (!curr) {
            cout << val << " not found.\n";
            return;
        }

        prev->next = curr->next;
        delete curr;

        cout << val << " deleted.\n";
    }

    void traverse() {
        NodeP6* temp = head;

        cout << "List: ";
        while (temp) {
            cout << temp->data << " -> ";
            temp = temp->next;
        }
        cout << "NULL\n";
    }

    void search(int val) {
        NodeP6* temp = head;
        int pos = 1;

        while (temp) {
            if (temp->data == val) {
                cout << val << " found at position "
                     << pos << "\n";
                return;
            }

            temp = temp->next;
            pos++;
        }

        cout << val << " not found.\n";
    }

    void reverse() {
        NodeP6* prev = nullptr;
        NodeP6* curr = head;
        NodeP6* next = nullptr;

        while (curr) {
            next = curr->next;
            curr->next = prev;
            prev = curr;
            curr = next;
        }

        head = prev;
        cout << "List reversed.\n";
    }
};

void practical6() {
    SLLP6 list;
    int ch, val;

    do {
        cout << "\n1.InsertBegin 2.InsertEnd 3.Delete "
             << "4.Traverse 5.Search 6.Reverse 0.Exit\n";
        cout << "Choice: ";
        cin >> ch;

        switch (ch) {
            case 1:
                cout << "Val: ";
                cin >> val;
                list.insertAtBegin(val);
                break;
            case 2:
                cout << "Val: ";
                cin >> val;
                list.insertAtEnd(val);
                break;
            case 3:
                cout << "Val: ";
                cin >> val;
                list.deleteNode(val);
                break;
            case 4:
                list.traverse();
                break;
            case 5:
                cout << "Search: ";
                cin >> val;
                list.search(val);
                break;
            case 6:
                list.reverse();
                break;
        }
    } while (ch != 0);
}


