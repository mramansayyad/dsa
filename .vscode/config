// ============================================================
class QueueP5 {
    int arr[MAX];
    int front, rear;

public:
    QueueP5() {
        front = -1;
        rear = -1;
    }

    bool isEmpty() {
        return front == -1;
    }

    bool isFull() {
        return rear == MAX - 1;
    }

    void enqueue(int val) {
        if (isFull()) {
            cout << "Queue is Full!\n";
            return;
        }

        if (isEmpty())
            front = 0;

        arr[++rear] = val;
        cout << val << " enqueued.\n";
    }

    void dequeue() {
        if (isEmpty()) {
            cout << "Queue is Empty!\n";
            return;
        }

        cout << arr[front] << " dequeued.\n";

        if (front == rear)
            front = rear = -1;
        else
            front++;
    }

    void traverse() {
        if (isEmpty()) {
            cout << "Queue is empty.\n";
            return;
        }

        cout << "Queue (front to rear): ";
        for (int i = front; i <= rear; i++)
            cout << arr[i] << " ";
        cout << "\n";
    }

    void search(int val) {
        if (isEmpty()) {
            cout << "Queue is empty.\n";
            return;
        }

        for (int i = front; i <= rear; i++) {
            if (arr[i] == val) {
                cout << val << " found at position "
                     << (i - front + 1) << ".\n";
                return;
            }
        }

        cout << val << " not found.\n";
    }
};

void practical5() {
    QueueP5 q;
    int choice, val;

    do {
        cout << "\n--- Queue Menu ---\n";
        cout << "1.Enqueue 2.Dequeue 3.Traverse 4.Search 0.Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Value: ";
                cin >> val;
                q.enqueue(val);
                break;
            case 2:
                q.dequeue();
                break;
            case 3:
                q.traverse();
                break;
            case 4:
                cout << "Search: ";
                cin >> val;
                q.search(val);
                break;
        }
    } while (choice != 0);
}


